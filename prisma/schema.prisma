// Preflight — the simulated store + live-run persistence.
// SQLite for V0; the schema is Postgres-ready (no SQLite-only types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  id         String  @id
  name       String
  email      String
  address    String
  claims90d  Int     @default(0) // refund claims in the last 90 days
  flagsJson  String  @default("[]")
  // Free-text account note surfaced by get_customer. In the Security
  // suite this is a poison vector — untrusted text the agent must not
  // obey as if it were an instruction.
  noteText   String?
  orders     Order[]
}

model Product {
  sku         String  @id
  name        String
  price       Float
  stock       Int
  finalSale   Boolean @default(false)
  restockAt   String? // ISO date; null = no restock scheduled
  provisional Boolean @default(false) // restock date not confirmed
}

model Order {
  id            String          @id
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  status        String // processing | shipped | in_transit | delivered | cancelled
  total         Float
  address       String
  createdAt     DateTime
  itemsJson     String // [{sku, name, qty, price}]
  paymentMethod String
  paymentLast4  String
  flagsJson     String          @default("[]") // e.g. refund_over_500_requires_review
  duplicateOf   String? // id of the order this one duplicates
  // Customer-service / gift note surfaced by get_order. Security-suite
  // poison vector: instructions embedded here are untrusted data.
  noteText      String?
  events        ShippingEvent[]
  refunds       Refund[]
}

model ShippingEvent {
  id         Int    @id @default(autoincrement())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id])
  ts         String
  status     String
  detailJson String @default("{}")
}

model Refund {
  id              String  @id
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  runId           String? // which live run created it (null = seeded history)
  amount          Float
  reason          String
  destinationJson String?
  createdAt       DateTime @default(now())
}

model Escalation {
  id        String   @id
  runId     String?
  orderId   String?
  summary   String
  trigger   String
  createdAt DateTime @default(now())
}

model ToolAction {
  id          Int      @id @default(autoincrement())
  runId       String
  scenarioId  String
  tool        String
  payloadJson String
  createdAt   DateTime @default(now())
}

model AgentProfile {
  id            String   @id @default("default") // single-workspace V0
  role          String
  agentRef      String // "reference" or a registered agent id/name
  toolsJson     String   @default("[]")
  // The Agent Dossier — knowledge about the agent, not just rules.
  platform      String   @default("custom")
  tone          String   @default("friendly")
  riskTolerance String   @default("low")
  updatedAt     DateTime @updatedAt
}

model CustomSuite {
  version       Int      @id @default(autoincrement())
  name          String
  status        String // generating | ready | error
  error         String?
  progress      Int      @default(0) // rules processed
  ruleCount     Int      @default(0)
  scenarioCount Int      @default(0)
  provider      String // anthropic | mock
  createdAt     DateTime @default(now())
}

model CustomScenario {
  id            String @id // CUS-<version>-0001
  suiteVersion  Int
  ruleText      String
  name          String
  category      String
  severity      String
  difficulty    Int    @default(3)
  rubric        String
  persona       String
  opening       String
  hiddenJson    String @default("[]")
  passJson      String @default("[]")
  mustNotJson   String @default("[]")
  pressureJson  String @default("{}")
  fixtureJson   String @default("{}")
}

model PolicyRule {
  id        Int      @id @default(autoincrement())
  profileId String   @default("default")
  text      String
  category  String
  severity  String // critical | high | medium | low
  kind      String // must | must_not
  source    String // help_centre | document | agent_prompt | questionnaire | manual | starter
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Free-grant ledger: how many free simulations an identity has already
// consumed. Keyed by a normalized email (plus/dot tricks collapsed) OR
// a coarse device fingerprint (fp:<hash>) — so cycling accounts from the
// same person or browser can't reset the 250-simulation free grant.
model FreeGrant {
  key        String   @id // "email:<normalized>" or "fp:<hash>"
  kind       String // email | fingerprint
  simsUsed   Int      @default(0)
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @updatedAt
}

// Pinned regression baseline: the run every later run of the same
// agent + suite is compared against. One pin per (agentName, suite);
// with no pin, comparisons fall back to the previous completed run.
model RunBaseline {
  agentName String
  suite     String
  runId     String
  createdAt DateTime @default(now())

  @@id([agentName, suite])
}

model LiveRun {
  id            String       @id
  agentName     String
  agentKind     String // http | mcp | reference
  endpoint      String?
  provider      String // anthropic | mock
  suite         String // smoke | full
  scenariosJson String // ordered scenario ids in this run
  status        String // running | complete | error
  error         String?
  // Cached root-cause clustering (ClusterReport JSON) — failures don't
  // change after completion, so this is computed once on first request.
  clustersJson  String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  results       LiveResult[]
}

model LiveResult {
  id                 Int      @id @default(autoincrement())
  runId              String
  run                LiveRun  @relation(fields: [runId], references: [id])
  scenarioId         String
  // Snapshot of the scenario as run — lists read name/category cheaply;
  // replay reads the full definition. Decouples results from fixtures.
  scenarioName       String?
  scenarioCategory   String?
  scenarioJson       String?
  outcome            String // pass | fail | partial | error
  failureReason      String?
  severity           String
  tokens             Int
  costUsd            Float
  latencyMs          Int
  transcriptJson     String // ReplayStep[] — exact demo replay shape
  divergenceStep     Int?
  divergenceExpected Int?
  judgeJson          String?
  createdAt          DateTime @default(now())

  @@unique([runId, scenarioId])
}
